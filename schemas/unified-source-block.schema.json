{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealsynq.local/schemas/unified-source-block.schema.json",
  "title": "DealSynq Unified Source Block",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_id", "type", "page", "block_id", "parent_block_id",
    "content", "coordinates", "coordinate_system", "extraction_method", "confidence",
    "validation", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "unified-source-block/1.0"},
    "document_id": {"type": "string", "minLength": 1},
    "type": {
      "enum": [
        "heading", "text", "footnote", "table", "table_header", "table_record",
        "chart", "chart_observation", "map", "map_binding", "photograph", "decoration", "unclassified_visual"
      ]
    },
    "page": {"type": "integer", "minimum": 1},
    "block_id": {"type": "string", "minLength": 1},
    "parent_block_id": {"type": ["string", "null"]},
    "content": {
      "type": "object",
      "not": {
        "anyOf": [
          {"required": ["vision_features"]},
          {"required": ["line_segments"]}
        ]
      }
    },
    "coordinates": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "number", "minimum": 0, "maximum": 1000}
    },
    "coordinate_system": {"const": "top-left normalized xywh 0..1000"},
    "extraction_method": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "errors", "warnings"],
      "properties": {
        "status": {"enum": ["passed", "needs_review", "failed"]},
        "errors": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_sha256", "region_id", "classification_method", "reading_order", "ocr_evidence_ids"],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "region_id": {"type": "string"},
        "classification_method": {"type": "string"},
        "reading_order": {"type": "integer", "minimum": 1},
        "ocr_evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
